# Variables de entorno — sgrai-web
#
# Copiar a .env y completar con los valores correspondientes.
# Ver GEMINI.md § 4 para más contexto.

# URL base de la API REST de sgrai-api
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del servidor Socket.io de sgrai-api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Número telefónico de emergencia para el botón persistente del Informante
NEXT_PUBLIC_EMERGENCY_PHONE=1451

# Enlaces institucionales y redes sociales de la Municipalidad de Valdivia
NEXT_PUBLIC_NEWS_URL=https://munivaldivia.cl/noticias/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/municipalidaddevaldivia/
NEXT_PUBLIC_X_URL=https://x.com/munivaldivia
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/channel/UCetNW4KMclDExRj9CsIyqig
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/munivaldivia
