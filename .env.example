# Variables de entorno — sgrai-web
#
# Copiar a .env.local y completar con los valores correspondientes.
# Ver GEMINI.md § 4 para más contexto.

# URL base de la API REST de sgrai-api
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL del servidor Socket.io de sgrai-api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Número telefónico de emergencia para el botón persistente del Informante
NEXT_PUBLIC_EMERGENCY_PHONE=1451
